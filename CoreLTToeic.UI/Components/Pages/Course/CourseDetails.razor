@page "/khoa-hoc/{Id:long}"
@inject ICourseLearningService CourseLearningService
@inject MessageService Message
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@(_course?.Title ?? "Khóa học")</PageTitle>
<div class="container py-4">
    @if (_loading) { <Spin Tip="Đang tải..." /> }
    else if (_course == null) { <Alert Type="AlertType.Error" Message="Khóa học không tồn tại hoặc chưa được xuất bản." /> }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <Tag Color="@LevelColor(_course.Level)">@LevelLabel(_course.Level)</Tag>
                <h1>@_course.Title</h1>
                <div class="course-markdown">@CourseMarkdownRenderer.Render(_course.Description)</div>
                @if (CourseMediaHelper.ToEmbedUrl(_course.PreviewVideoUrl) is { } previewVideoUrl)
                {
                    <div class="ratio ratio-16x9 mt-4">
                        <iframe src="@previewVideoUrl"
                                title="@($"Giới thiệu {_course.Title}")"
                                loading="lazy"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allowfullscreen></iframe>
                    </div>
                }
                <h2 class="h4 mt-4">Mục tiêu</h2>
                <div class="course-markdown">@CourseMarkdownRenderer.Render(_course.Objective)</div>
                <h2 class="h4 mt-4">Chương trình học</h2>
                @foreach (var courseSection in _course.Sections)
                {
                    <div class="card mb-3"><div class="card-header"><strong>@courseSection.Title</strong></div>
                        <ul class="list-group list-group-flush">
                            @foreach (var lesson in courseSection.Lessons)
                            {
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>@LessonLabel(lesson.Type) · @lesson.Title</span>
                                    <span>@lesson.Duration phút</span>
                                </li>
                            }
                        </ul>
                    </div>
                }
                <h2 class="h4 mt-4">Đánh giá (@_course.ReviewCount)</h2>
                @foreach (var review in _course.Reviews)
                {
                    <div class="border rounded p-3 mb-2"><strong>@review.UserDisplayName</strong> · @review.Rating/5 ★
                        <div>@review.Comment</div><small class="text-muted">@review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small>
                    </div>
                }
            </div>
            <div class="col-lg-4">
                <div class="card shadow-sm sticky-top" style="top:80px">
                    @if (!string.IsNullOrWhiteSpace(_course.ThumbnailUrl))
                    {
                        <img src="@_course.ThumbnailUrl"
                             class="card-img-top"
                             alt="@_course.Title"
                             style="aspect-ratio:16/9;object-fit:cover" />
                    }
                    <div class="card-body">
                    <h3 class="h4">Miễn phí</h3>
                    <p>@_course.TotalLessons bài · @_course.TotalDuration phút</p>
                    @if (_course.IsEnrolled)
                    {
                        <Progress Percent="@_course.ProgressPercent" />
                        <Button Type="ButtonType.Primary" Block OnClick="StartLearning" Style="margin-top:12px">Tiếp tục học</Button>
                    }
                    else
                    {
                        <Button Type="ButtonType.Primary" Block Loading="_enrolling" OnClick="Enroll">Đăng ký miễn phí</Button>
                    }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public long Id { get; set; }
    private CourseDetailViewModel? _course;
    private string? _userId;
    private bool _loading = true;
    private bool _enrolling;

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        try { _course = await CourseLearningService.GetCourseDetailsAsync(Id, _userId); }
        catch (UnauthorizedAccessException) { Nav.NavigateTo("/tai-khoan-bi-khoa"); }
        catch (Exception ex) { await Message.ErrorAsync(ex.Message); }
        finally { _loading = false; }
    }
    private async Task Enroll()
    {
        if (_userId == null) { Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString($"/khoa-hoc/{Id}")}"); return; }
        _enrolling = true;
        try { await CourseLearningService.EnrollAsync(Id, _userId); await Message.SuccessAsync("Đăng ký thành công."); StartLearning(); }
        catch (UnauthorizedAccessException) { Nav.NavigateTo("/tai-khoan-bi-khoa"); }
        catch (Exception ex) { await Message.ErrorAsync(ex.Message); }
        finally { _enrolling = false; }
    }
    private void StartLearning()
    {
        if (_userId == null) Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString($"/khoa-hoc/{Id}/hoc")}");
        else Nav.NavigateTo($"/khoa-hoc/{Id}/hoc");
    }
    private static string LevelLabel(CourseLevel level) => level switch
    {
        CourseLevel.Beginner => "Cơ bản",
        CourseLevel.Intermediate => "Khá",
        _ => "Nâng cao"
    };
    private static string LevelColor(CourseLevel level) => level switch
    {
        CourseLevel.Beginner => "blue",
        CourseLevel.Intermediate => "orange",
        _ => "red"
    };
    private static string LessonLabel(LessonType type) => type switch { LessonType.Video => "Video", LessonType.Quiz => "Kiểm tra", _ => "Bài đọc" };
}
