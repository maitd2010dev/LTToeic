        position: sticky;
        top: 0;
        z-index: 100;
        background: #fff;
        border-bottom: 1px solid #e8e8e8;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 0 24px;
        height: 56px;
        box-shadow: 0 2px 6px rgba(0,0,0,.06);
    }

    .tt-brand {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1B527A;
        white-space: nowrap;
    }

    .tt-topbar-spacer {
        /* placeholder when viewing results */
    }

    .tt-timer {
        font-size: 15px;
        font-weight: 700;
        color: #1B527A;
        text-align: center;
        white-space: nowrap;
