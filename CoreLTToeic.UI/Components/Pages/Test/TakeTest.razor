    .tt-submit-btn {
        justify-self: end;
        background: #1B527A !important;
        border-color: #1B527A !important;
        font-weight: 600 !important;
    }

    .tt-submit-btn:hover {
        background: #154060 !important;
        border-color: #154060 !important;
    }

    .tt-back-btn {
        justify-self: end;
    }

    /* Part tabs bar */
    .tt-part-tabs {
        position: sticky;
        top: 56px;
        z-index: 99;
        background: #fff;
        border-bottom: 1px solid #e8e8e8;
        display: flex;
        padding: 0 16px;
    }

    .tt-tab-btn {
        padding: 10px 18px;
        border: none;
        border-bottom: 2px solid transparent;
        background: none;
        cursor: pointer;
        font-size: 14px;
        color: #666;
        margin-bottom: -1px;
        transition: color 0.15s, border-color 0.15s;
        white-space: nowrap;
    }

    .tt-tab-btn:hover {
        color: #1B527A;
    }

    .tt-tab-btn.tt-tab-active {
        color: #1B527A;
        font-weight: 700;
        border-bottom-color: #1B527A;
    }

    /* Result banner */
    .tt-result-banner {
        display: flex;
        align-items: center;
        gap: 24px;
        background: linear-gradient(135deg, #1B527A 0%, #2471A3 100%);
        color: #fff;
        padding: 16px 24px;
        flex-wrap: wrap;
    }

    .tt-result-score {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0;
    }

    .tt-score-total {
        font-size: 36px;
        font-weight: 800;
