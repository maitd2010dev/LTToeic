@page "/luyen-thi/{TestId:long}"
@layout TestLayout
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject ITestService TestService
@inject IUserResultService UserResultService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject MessageService Message
@inject IJSRuntime JS

<PageTitle>@(_test?.Title ?? "Đang tải...")</PageTitle>

@if (_loading)
{
    <div style="display:flex;align-items:center;justify-content:center;height:100vh">
        <Spin Tip="Đang tải đề thi..." />
    </div>
}
else if (_test == null)
{
    <div style="text-align:center;padding:80px 16px;color:#888">
        <Icon Type="file-unknown" Style="font-size:48px;margin-bottom:12px;display:block" />
        <p>Không tìm thấy đề thi</p>
    </div>
}
else if (!_testStarted)
{
    <TestStartScreen Test="_test" Parts="_parts" OnStart="HandleStart" />
}
else
{
    <div class="tt-root" id="toeic-test-root">
        <!-- Top bar: Brand | Timer | Submit -->
        <div class="tt-topbar">
            <span class="tt-brand">LTToeic Practice</span>

            @if (!_isViewResult)
            {
                @if (_countUp)
                {
                    <div class="tt-timer">
                        Thời gian: @FormatTime(_elapsedSeconds)
                    </div>
                }
                else
                {
                    <div class="tt-timer @(_remainingSeconds <= 300 ? "tt-timer-urgent" : "")">
                        Thời gian còn lại: @FormatTime(_remainingSeconds)
                    </div>
                }
                <Button Type="@ButtonType.Primary" Class="tt-submit-btn"
                        OnClick="ConfirmSubmit" Loading="_submitting">
                    Nộp bài
                </Button>
            }
            else
            {
                <div class="tt-topbar-spacer"></div>
                <Button Type="@ButtonType.Default" Class="tt-back-btn"
                        OnClick="@(() => Nav.NavigateTo("/luyen-thi"))">
                    <Icon Type="arrow-left" /> Đề thi khác
                </Button>
            }
        </div>

        <!-- Part tabs -->
        <div class="tt-part-tabs">
            @foreach (var part in _parts)
            {
                <button class="tt-tab-btn @(_activePartId == part.Id ? "tt-tab-active" : "")"
                        @onclick="() => SelectPart(part.Id)">
                    Part @((int)part.PartNum)
                </button>
            }
        </div>

        <!-- Result banner -->
        @if (_isViewResult && _result != null)
        {
            <div class="tt-result-banner">
                <div class="tt-result-score">
                    <span class="tt-score-total">@_result.TotalScore<span class="tt-score-max">/@ResultMaxScore</span></span>
                    <span class="tt-score-label">TỔNG ĐIỂM</span>
                </div>
                <div class="tt-result-details">
                    @if (_result.TotalListeningQuestions > 0)
                    {
                        <div class="tt-result-item">
                            <span class="tt-result-val">@_result.ListeningScore</span>
                            <span class="tt-result-key">Listening</span>
                        </div>
                        <div class="tt-result-divider"></div>
                    }
                    @if (_result.TotalReadingQuestions > 0)
                    {
                        <div class="tt-result-item">
                            <span class="tt-result-val">@_result.ReadingScore</span>
                            <span class="tt-result-key">Reading</span>
                        </div>
                        <div class="tt-result-divider"></div>
                    }
                    <div class="tt-result-item tt-correct">
                        <span class="tt-result-val">@_result.CorrectAnswers</span>
                        <span class="tt-result-key">Đúng</span>
                    </div>
                    <div class="tt-result-divider"></div>
                    <div class="tt-result-item tt-wrong">
                        <span class="tt-result-val">@_result.IncorrectAnswers</span>
                        <span class="tt-result-key">Sai</span>
                    </div>
                    <div class="tt-result-divider"></div>
                    <div class="tt-result-item">
                        <span class="tt-result-val">@_result.SkippedAnswers</span>
                        <span class="tt-result-key">Bỏ qua</span>
                    </div>
                    <div class="tt-result-divider"></div>
                    <div class="tt-result-item">
                        <span class="tt-result-val">@_result.Accuracy.ToString("F1")%</span>
                        <span class="tt-result-key">Chính xác</span>
                    </div>
                </div>
            </div>
        }

        <!-- Main: questions + answer sheet -->
        <div class="tt-body">
            <div class="tt-questions">
                @foreach (var part in _parts)
                {
                    var standalones = _standaloneQuestions.Where(q => q.PartId == part.Id).ToList();
                    var groups = _allGroups.Where(g => g.PartId == part.Id).ToList();
                    if (!standalones.Any() && !groups.Any()) continue;

                    <TestPartSection
                        Part="part"
                        StandaloneQuestions="standalones"
                        Groups="groups"
                        QuestionNumberMap="_questionNumberMap"
                        UserAnswers="_userAnswers"
                        IsViewResult="_isViewResult"
                        OnAnswerSelected="HandleAnswer" />
                }
            </div>

            <div class="tt-sheet-col">
                <TestAnswerSheet
                    Parts="_parts"
                    QuestionIndex="_questionIndex"
                    PartQuestionIds="_partQuestionIds"
                    UserAnswers="_userAnswers"
                    IsViewResult="_isViewResult"
                    CorrectAnswers="_correctAnswers"
                    OnQuestionClicked="ScrollToQuestion" />
            </div>
        </div>
    </div>
}

<style>
