@page "/luyen-thi"
@rendermode InteractiveServer
@inject ITestService TestService
@inject NavigationManager Nav
@inject MessageService Message

<PageTitle>Thư viện đề thi - LTToeic</PageTitle>

<h1 class="library-heading">Thư viện đề thi</h1>
<hr class="library-separator" />

<div class="search-row">
    <input class="search-input-field"
           placeholder="Tìm kiếm đề thi..."
           @bind="_searchText"
           @bind:event="oninput"
           @onkeyup="OnSearchKeyUp" />
    <Button Type="ButtonType.Primary" Class="search-btn" OnClick="FilterTests">Tìm kiếm</Button>
</div>

@if (_categories.Count > 0)
{
    <div class="test-category-filter" aria-label="Lọc theo danh mục">
        <button type="button"
                class="@GetCategoryButtonClass(null)"
                @onclick="() => SelectCategory(null)">
            Tất cả
        </button>
        @foreach (var category in _categories)
        {
            <button type="button"
                    class="@GetCategoryButtonClass(category.Id)"
                    @onclick="() => SelectCategory(category.Id)">
                @category.Name
                <span>@category.Tests.Count(t => t.Status == TestStatus.Active)</span>
            </button>
        }
    </div>
}

@if (_loading)
{
    <div class="loading-center"><Spin /></div>
}
else if (_filtered.Count == 0)
{
    <div class="empty-state">Không có đề thi nào phù hợp</div>
}
else
{
    <div class="test-grid">
        @foreach (var test in _filtered)
        {
            <div class="test-card">
                <div class="test-card-info">
                    <div class="test-card-title">@test.Title</div>
                    @if (!string.IsNullOrWhiteSpace(test.CategoryName))
                    {
                        <span class="test-card-category">@test.CategoryName</span>
                    }
                    <div class="test-card-meta">
                        <Icon Type="clock-circle" Theme="IconThemeType.Outline" />
                        @test.Duration phút &nbsp;|&nbsp; @test.TotalQuestions câu
                    </div>
                </div>
                <Button Type="ButtonType.Primary" Class="btn-lam-bai"
                        OnClick='() => Nav.NavigateTo($"/luyen-thi/{test.Id}")'>
                    Làm bài
                </Button>
            </div>
        }
    </div>
}

@code {
    private List<TestViewModel> _all = [];
    private List<TestViewModel> _filtered = [];
    private List<TestCategoryViewModel> _categories = [];
    private string _searchText = "";
    private long? _selectedCategoryId;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var testsTask = TestService.GetAllAsync();
            var categoriesTask = TestService.GetCategoriesAsync();
            await Task.WhenAll(testsTask, categoriesTask);

            _all = testsTask.Result.Where(t => t.Status == TestStatus.Active).ToList();
            _categories = categoriesTask.Result
                .Where(c => c.Tests.Any(t => t.Status == TestStatus.Active))
                .ToList();
            FilterTests();
        }
        catch (Exception ex)
        {
            await Message.ErrorAsync($"Lỗi tải danh sách đề thi: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private void FilterTests()
    {
        IEnumerable<TestViewModel> query = _all;

        if (_selectedCategoryId.HasValue)
            query = query.Where(t => t.TestCategoryId == _selectedCategoryId.Value);

        if (!string.IsNullOrWhiteSpace(_searchText))
            query = query.Where(t => t.Title.Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase));

        _filtered = query.ToList();
    }

    private void SelectCategory(long? categoryId)
    {
        _selectedCategoryId = categoryId;
        FilterTests();
    }

    private string GetCategoryButtonClass(long? categoryId) =>
        _selectedCategoryId == categoryId ? "test-category-chip active" : "test-category-chip";

    private void OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") FilterTests();
    }
}
