@page "/admin/quan-li-khoa-hoc"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject ICourseService CourseService
@inject MessageService Message
@inject ModalService Modal
@inject NavigationManager Nav

<div class="admin-page-header">
    <div>
        <h2 class="admin-page-title">Quản lý khóa học</h2>
        <p class="admin-page-subtitle">Tạo khóa học và quản lý toàn bộ chương trình học.</p>
    </div>
    <Button Type="ButtonType.Primary" Icon="plus" OnClick="OpenCreate">Thêm khóa học</Button>
</div>

<div class="admin-table-card">
    <div style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:12px;margin-bottom:16px">
        <Input @bind-Value="_search" Placeholder="Tìm theo tên khóa học..." />
        <select class="ant-input" @bind="_statusFilter">
            <option value="">Tất cả trạng thái</option>
            <option value="Draft">Bản nháp</option>
            <option value="Published">Đã xuất bản</option>
        </select>
        <select class="ant-input" @bind="_levelFilter">
            <option value="">Tất cả cấp độ</option>
            <option value="Beginner">Cơ bản</option>
            <option value="Intermediate">Trung cấp</option>
            <option value="Advanced">Nâng cao</option>
        </select>
    </div>

    <Table DataSource="FilteredCourses" TItem="CourseViewModel" Loading="_loading" Bordered Size="TableSize.Small">
        <PropertyColumn Property="c => c.Title" Title="Khóa học" Sortable />
        <ActionColumn Title="Cấp độ" Width="120">
            <Tag Color="@LevelColor(context.Level)">@LevelLabel(context.Level)</Tag>
        </ActionColumn>
        <ActionColumn Title="Trạng thái" Width="130">
            <Tag Color="@(context.Status == CourseStatus.Published ? "success" : "warning")">
                @(context.Status == CourseStatus.Published ? "Đã xuất bản" : "Bản nháp")
            </Tag>
        </ActionColumn>
        <ActionColumn Title="Nội dung" Width="120">@context.SectionCount chương / @context.TotalLessons bài</ActionColumn>
        <ActionColumn Title="Học viên" Width="90">@context.EnrollmentCount</ActionColumn>
        <ActionColumn Title="Thao tác" Width="130">
            <Space>
                <SpaceItem><Button Size="ButtonSize.Small" Icon="edit" OnClick="() => Edit(context.Id)">Sửa</Button></SpaceItem>
                <SpaceItem><Button Danger Size="ButtonSize.Small" Icon="delete" OnClick="() => Delete(context.Id)" /></SpaceItem>
            </Space>
        </ActionColumn>
    </Table>
</div>

<Modal Visible="_createOpen" Title="@("Tạo khóa học")" Footer="null" OnCancel="CloseCreate" DestroyOnClose>
    <Form Model="_model" OnFinish="Create" Layout="@FormLayout.Vertical">
        <FormItem Label="Tên khóa học" Required>
            <Input @bind-Value="_model.Title" />
        </FormItem>
        <FormItem Label="Mô tả" Required>
            <TextArea @bind-Value="_model.Description" Rows="4" />
        </FormItem>
        <FormItem Label="Cấp độ">
            <select class="ant-input" @bind="_model.Level">
                <option value="@CourseLevel.Beginner">Cơ bản</option>
                <option value="@CourseLevel.Intermediate">Trung cấp</option>
                <option value="@CourseLevel.Advanced">Nâng cao</option>
            </select>
        </FormItem>
        <p style="color:#64748b">Khóa học miễn phí. Sau khi tạo, hãy thêm chương và bài học trước khi xuất bản.</p>
        <div style="display:flex;justify-content:flex-end;gap:8px">
            <Button OnClick="CloseCreate">Hủy</Button>
            <Button Type="ButtonType.Primary" HtmlType="submit" Loading="_saving">Tạo khóa học</Button>
        </div>
    </Form>
</Modal>

@code {
    private List<CourseViewModel> _courses = [];
    private bool _loading;
    private bool _saving;
    private bool _createOpen;
    private string _search = "";
    private string _statusFilter = "";
    private string _levelFilter = "";
    private CourseEditModel _model = new();

    private IEnumerable<CourseViewModel> FilteredCourses => _courses.Where(c =>
        (string.IsNullOrWhiteSpace(_search) || c.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_statusFilter) || c.Status.ToString() == _statusFilter) &&
        (string.IsNullOrEmpty(_levelFilter) || c.Level.ToString() == _levelFilter));

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        _loading = true;
        try { _courses = await CourseService.GetAllAsync(); }
        catch (Exception ex) { await Message.ErrorAsync(ex.Message); }
        finally { _loading = false; }
    }

    private void OpenCreate()
    {
        _model = new CourseEditModel { Status = CourseStatus.Draft, Price = 0 };
        _createOpen = true;
    }

    private void CloseCreate() => _createOpen = false;

    private async Task Create()
    {
        _saving = true;
        try
        {
            var course = await CourseService.CreateAsync(_model, null);
            await Message.SuccessAsync("Đã tạo khóa học.");
            _createOpen = false;
            Nav.NavigateTo($"/admin/quan-li-khoa-hoc/{course.Id}");
        }
        catch (Exception ex) { await Message.ErrorAsync(ex.Message); }
        finally { _saving = false; }
    }

    private void Edit(long id) => Nav.NavigateTo($"/admin/quan-li-khoa-hoc/{id}");

    private async Task Delete(long id)
    {
        var confirmed = await Modal.ConfirmAsync(new ConfirmOptions
        {
            Title = "Xóa khóa học?",
            Content = "Khóa học có dữ liệu học viên sẽ không thể xóa. Khi đó hãy chuyển về bản nháp.",
            OkText = "Xóa",
            CancelText = "Hủy",
            OkButtonProps = new ButtonProps { Danger = true }
        });
        if (!confirmed) return;
        try
        {
            await CourseService.DeleteAsync(id);
            await Message.SuccessAsync("Đã xóa khóa học.");
            await Load();
        }
        catch (Exception ex) { await Message.ErrorAsync(ex.Message); }
    }

    private static string LevelColor(CourseLevel level) => level switch
    {
        CourseLevel.Beginner => "blue",
        CourseLevel.Intermediate => "orange",
        _ => "red"
    };

    private static string LevelLabel(CourseLevel level) => level switch
    {
        CourseLevel.Beginner => "Cơ bản",
        CourseLevel.Intermediate => "Trung cấp",
        _ => "Nâng cao"
    };
}
