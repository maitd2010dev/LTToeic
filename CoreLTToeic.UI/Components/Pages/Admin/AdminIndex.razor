@page "/admin"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@using AntDesign.Charts
@inject IAdminService AdminService
@inject NavigationManager Nav
@inject MessageService Message

<PageTitle>Tổng quan — LTToeic Admin</PageTitle>

<div style="padding:8px 0 24px;">
    <h2 style="margin:0 0 4px;">Tổng quan hệ thống</h2>
    <span style="color:#8c8c8c;">Chào mừng trở lại bảng điều khiển LTToeic</span>
</div>

@if (_loading)
{
    <div style="text-align:center;padding:80px 0;">
        <Spin Tip="Đang tải dữ liệu..." />
    </div>
}
else if (_stats != null)
{
    <Row Gutter="(16, 16)" Style="margin-bottom:24px;">
        <AntDesign.Col Xs="24" Sm="12" Md="6">
            <Card Bordered Style="border-radius:12px;text-align:center;">
                <div style="margin-bottom:8px;">
                    <Icon Type="team" Theme="IconThemeType.Outline" Style="font-size:28px;color:#1B527A;" />
                </div>
                <Statistic Title="Tài khoản"
                           Value="@_stats.TotalUsers"
                           ValueStyle="color:#1B527A;font-weight:700;font-size:2rem;" />
            </Card>
        </AntDesign.Col>
        <AntDesign.Col Xs="24" Sm="12" Md="6">
            <Card Bordered Style="border-radius:12px;text-align:center;">
                <div style="margin-bottom:8px;">
                    <Icon Type="file-text" Theme="IconThemeType.Outline" Style="font-size:28px;color:#52c41a;" />
                </div>
                <Statistic Title="Đề thi"
                           Value="@_stats.TotalTests"
                           ValueStyle="color:#52c41a;font-weight:700;font-size:2rem;" />
            </Card>
        </AntDesign.Col>
        <AntDesign.Col Xs="24" Sm="12" Md="6">
            <Card Bordered Style="border-radius:12px;text-align:center;">
                <div style="margin-bottom:8px;">
                    <Icon Type="solution" Theme="IconThemeType.Outline" Style="font-size:28px;color:#fa8c16;" />
                </div>
                <Statistic Title="Lượt thi hoàn thành"
                           Value="@_stats.TotalCompletedResults"
                           ValueStyle="color:#fa8c16;font-weight:700;font-size:2rem;" />
            </Card>
        </AntDesign.Col>
        <AntDesign.Col Xs="24" Sm="12" Md="6">
            <Card Bordered Style="border-radius:12px;text-align:center;">
                <div style="margin-bottom:8px;">
                    <Icon Type="book" Theme="IconThemeType.Outline" Style="font-size:28px;color:#13c2c2;" />
                </div>
                <Statistic Title="Khóa học"
                           Value="@_stats.TotalCourses"
                           ValueStyle="color:#13c2c2;font-weight:700;font-size:2rem;" />
            </Card>
        </AntDesign.Col>
    </Row>

    <Card Title="Số người làm đề thi trong 12 tháng"
          Bordered
          Style="border-radius:12px;margin-bottom:24px;">
        <div style="color:#8c8c8c;margin-bottom:16px;">
            Số tài khoản duy nhất có ít nhất một bài thi hoàn thành trong từng tháng
        </div>
        <AntDesign.Charts.Column Data="@_monthlyParticipantChartData"
                                 Config="@_monthlyParticipantChartConfig" />
    </Card>
}

<Row Gutter="(16, 16)" Style="margin-bottom:24px;">
    <AntDesign.Col Xs="24" Sm="12" Md="8">
        <div @onclick='() => Nav.NavigateTo("/admin/quan-li-de-thi")' style="cursor:pointer;">
            <Card Hoverable Bordered Style="border-radius:12px;">
                <div style="display:flex; align-items:center; gap:16px;">
                    <div style="width:48px; height:48px; border-radius:10px; background:#e6f4ff; display:flex; align-items:center; justify-content:center;">
                        <Icon Type="file-text" Theme="IconThemeType.Outline" Style="font-size:24px; color:#1677ff;" />
                    </div>
                    <div>
                        <div style="font-size:0.85rem; color:#8c8c8c;">Quản lý</div>
                        <div style="font-size:1rem; font-weight:600;">Đề thi</div>
                    </div>
                </div>
            </Card>
        </div>
    </AntDesign.Col>
    <AntDesign.Col Xs="24" Sm="12" Md="8">
        <div @onclick='() => Nav.NavigateTo("/admin/quan-li-tai-khoan")' style="cursor:pointer;">
            <Card Hoverable Bordered Style="border-radius:12px;">
                <div style="display:flex; align-items:center; gap:16px;">
                    <div style="width:48px; height:48px; border-radius:10px; background:#fff7e6; display:flex; align-items:center; justify-content:center;">
                        <Icon Type="team" Theme="IconThemeType.Outline" Style="font-size:24px; color:#fa8c16;" />
                    </div>
                    <div>
                        <div style="font-size:0.85rem; color:#8c8c8c;">Quản lý</div>
                        <div style="font-size:1rem; font-weight:600;">Tài khoản</div>
                    </div>
                </div>
            </Card>
        </div>
    </AntDesign.Col>
    <AntDesign.Col Xs="24" Sm="12" Md="8">
        <div @onclick='() => Nav.NavigateTo("/admin/quan-li-khoa-hoc")' style="cursor:pointer;">
            <Card Hoverable Bordered Style="border-radius:12px;">
                <div style="display:flex; align-items:center; gap:16px;">
                    <div style="width:48px; height:48px; border-radius:10px; background:#f9f0ff; display:flex; align-items:center; justify-content:center;">
                        <Icon Type="book" Theme="IconThemeType.Outline" Style="font-size:24px; color:#722ed1;" />
                    </div>
                    <div>
                        <div style="font-size:0.85rem; color:#8c8c8c;">Quản lý</div>
                        <div style="font-size:1rem; font-weight:600;">Khóa học</div>
                    </div>
                </div>
            </Card>
        </div>
    </AntDesign.Col>
</Row>

<Row Gutter="(16, 16)">
    <AntDesign.Col Xs="24" Md="12">
        <Card Title="Truy cập nhanh" Bordered Style="border-radius:12px;">
            <Button Block Icon="plus" Style="margin-bottom:8px;"
                    OnClick='() => Nav.NavigateTo("/admin/quan-li-de-thi")'>
                Thêm đề thi mới
            </Button>
            <Button Block Icon="solution" Style="margin-bottom:8px;"
                    OnClick='() => Nav.NavigateTo("/admin/quan-li-ket-qua")'>
                Xem kết quả thi
            </Button>
            <Button Block Icon="video-camera"
                    OnClick='() => Nav.NavigateTo("/admin/quan-li-khoa-hoc")'>
                Quản lý khóa học
            </Button>
        </Card>
    </AntDesign.Col>
    <AntDesign.Col Xs="24" Md="12">
        <Card Title="Liên kết hữu ích" Bordered Style="border-radius:12px;">
            <Button Block Type="ButtonType.Link" Icon="home" Style="margin-bottom:8px;"
                    OnClick='() => Nav.NavigateTo("/")'>
                Xem trang người dùng
            </Button>
            <Button Block Type="ButtonType.Link" Icon="unordered-list"
                    OnClick='() => Nav.NavigateTo("/luyen-thi")'>
                Danh sách đề thi
            </Button>
        </Card>
    </AntDesign.Col>
</Row>

@code {
    private AdminDashboardViewModel? _stats;
    private bool _loading = true;
    private object[] _monthlyParticipantChartData = [];
    private readonly ColumnConfig _monthlyParticipantChartConfig = new()
    {
        Height = 300,
        AutoFit = true,
        Padding = "auto",
        XField = "month",
        YField = "participantCount",
        Color = "#1677ff",
        Meta = new
        {
            month = new { Alias = "Tháng" },
            participantCount = new { Alias = "Số người" }
        },
        YAxis = new ValueAxis
        {
            Min = 0,
            TickInterval = 1
        },
        Tooltip = new AntDesign.Charts.Tooltip()
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _stats = await AdminService.GetDashboardStatsAsync();
            _monthlyParticipantChartData = _stats.MonthlyExamParticipants
                .Select(item => new
                {
                    month = item.Month,
                    participantCount = item.ParticipantCount
                })
                .ToArray();
        }
        catch (Exception ex)
        {
            await Message.ErrorAsync($"Lỗi tải thống kê: {ex.Message}");
        }
        finally { _loading = false; }
    }
}
