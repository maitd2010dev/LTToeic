@inject IJSRuntime JS

<div id="@_wrapperId" class="rich-text-editor">
    <TextEditor @ref="_editor"
                Theme="EditorTheme.Snow"
                OnTextChanged="HandleChanged"
                WrapImagesInFigures="true">
        <ToolbarContent>
            <span class="ql-formats">
                <button class="ql-bold"></button>
                <button class="ql-italic"></button>
                <button class="ql-underline"></button>
            </span>
            <span class="ql-formats">
                <button class="ql-list" value="ordered"></button>
                <button class="ql-list" value="bullet"></button>
            </span>
            <span class="ql-formats">
                <button class="ql-link"></button>
                <button class="ql-image"></button>
            </span>
        </ToolbarContent>
    </TextEditor>
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public int Height { get; set; } = 280;
    [Parameter] public bool ConvertLegacyMarkdown { get; set; }

    private TextEditor _editor = null!;
    private string _wrapperId = "qeditor-" + Guid.NewGuid().ToString("N")[..8];
    private bool _initialized;
    private string _lastValue = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(100); // allow Quill to fully initialize
            if (!string.IsNullOrEmpty(Value))
            {
                await SetEditorValueAsync(Value);
                _lastValue = Value;
            }
            await JS.InvokeVoidAsync("QuillHelpers.setEditorHeight", _wrapperId, Height);
            _initialized = true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized && Value != _lastValue)
        {
            _lastValue = Value;
            await SetEditorValueAsync(Value);
            await JS.InvokeVoidAsync("QuillHelpers.setEditorHeight", _wrapperId, Height);
        }
    }

    private async Task HandleChanged()
    {
        var html = await JS.InvokeAsync<string>("QuillHelpers.getEditorHTML", _wrapperId);
        _lastValue = html;
        if (html != Value)
        {
            Value = html;
            await ValueChanged.InvokeAsync(html);
        }
    }

    private ValueTask SetEditorValueAsync(string? value)
    {
        var editorValue = ConvertLegacyMarkdown && !CourseMarkdownRenderer.IsHtml(value)
            ? CourseMarkdownRenderer.Render(value).Value
            : value ?? "";
        return JS.InvokeVoidAsync("QuillHelpers.setEditorHTML", _wrapperId, editorValue);
    }
}
