<div class="tqg-block">
    @if (ShowAudio && !string.IsNullOrEmpty(Group.Audio))
    {
        <div style="margin-bottom:10px">
            <audio controls src="@Group.Audio" style="width:100%;height:32px" />
        </div>
    }

    @if (Group.Images != null && Group.Images.Any(i => !string.IsNullOrEmpty(i)))
    {
        <div class="tqg-images">
            @foreach (var img in Group.Images.Where(i => !string.IsNullOrEmpty(i)))
            {
                <img src="@ResolveImage(img)" alt="img" class="tqg-image" />
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Group.Content))
    {
        @if (IsListeningGroup)
        {
            @if (IsViewResult)
            {
                <div class="tqg-transcript">
                    <div class="tqg-transcript-toggle" @onclick="() => _transcriptOpen = !_transcriptOpen">
                        <Icon Type="@(_transcriptOpen ? "up" : "down")" />
                        Transcript
                    </div>
                    @if (_transcriptOpen)
                    {
                        <div class="tqg-transcript-body">@((MarkupString)Group.Content)</div>
                    }
                </div>
            }
        }
        else
        {
            <div class="tqg-passage">@((MarkupString)Group.Content)</div>
        }
    }

    <div class="tqg-questions">
        @foreach (var q in Group.Questions.OrderBy(x => x.OrderNumber))
        {
            var num = QuestionNumberMap.GetValueOrDefault(q.Id, 0);
            <TestQuestionItem
                Question="q"
                QuestionNumber="num"
                SelectedAnswer="@(UserAnswers.GetValueOrDefault(q.Id))"
                IsViewResult="IsViewResult"
                OnAnswerSelected="@(ans => HandleAnswer(q.Id, ans))" />
        }
    </div>
</div>

<style>
    .tqg-block {
        border: 1px solid #e0e8ff;
        border-radius: 10px;
        background: #f7f9ff;
        padding: 14px;
        margin-bottom: 16px;
    }

    .tqg-images {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px;
        margin-bottom: 10px;
    }

    .tqg-image {
        min-height: 160px;
        max-height: 320px;
        max-width: 100%;
        border-radius: 6px;
        object-fit: contain;
    }

    .tqg-passage {
        font-size: 14px;
        line-height: 1.75;
        color: #333;
        background: #fff;
        border-left: 3px solid #1677ff;
        padding: 10px 14px;
        border-radius: 0 6px 6px 0;
        margin-bottom: 14px;
        max-height: 240px;
        overflow-y: auto;
    }

    .tqg-transcript {
        margin-bottom: 14px;
        border: 1px solid #d6e4ff;
        border-radius: 6px;
        background: #fff;
    }

    .tqg-transcript-toggle {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 9px 12px;
        color: #555;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        user-select: none;
    }

    .tqg-transcript-toggle:hover {
        color: #1677ff;
    }

    .tqg-transcript-body {
        padding: 10px 12px;
        border-top: 1px dashed #e8e8e8;
        color: #555;
        font-size: 13px;
        line-height: 1.6;
        white-space: pre-wrap;
    }

    .tqg-questions {
        display: flex;
        flex-direction: column;
        gap: 0;
    }
</style>

@code {
    [Parameter, EditorRequired] public QuestionGroupViewModel Group { get; set; } = null!;
    [Parameter] public Dictionary<long, int> QuestionNumberMap { get; set; } = [];
    [Parameter] public Dictionary<long, string> UserAnswers { get; set; } = [];
    [Parameter] public bool IsViewResult { get; set; }
    [Parameter] public bool IsListeningPart { get; set; }
    [Parameter] public bool ShowAudio { get; set; } = true;
    [Parameter] public EventCallback<(long QuestionId, string Answer)> OnAnswerSelected { get; set; }

    private bool _transcriptOpen;
    private bool IsListeningGroup =>
        IsListeningPart || Group.PartNum is ToeicLRPart.Part3 or ToeicLRPart.Part4;

    private async Task HandleAnswer(long questionId, string answer)
    {
        await OnAnswerSelected.InvokeAsync((questionId, answer));
    }

    private static string ResolveImage(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return string.Empty;
        if (url.StartsWith("http://") || url.StartsWith("https://")) return url;
        return "https://storage.googleapis.com/" + url.TrimStart('/');
    }
}
