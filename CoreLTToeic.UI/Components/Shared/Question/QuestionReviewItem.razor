@using AntDesign
@using CoreLTToeic.Application.Models.ViewModels

<Card Style="margin-bottom:12px; border-radius:8px;" Bordered>
    <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
        <strong style="font-size:1rem;">Câu @QuestionNumber</strong>
        @if (Answer.IsCorrect)
        {
            <Tag Color="@("success")">Đúng</Tag>
        }
        else if (string.IsNullOrEmpty(Answer.SelectedAnswer))
        {
            <Tag>Bỏ qua</Tag>
        }
        else
        {
            <Tag Color="@("error")">Sai</Tag>
        }
        @if (Answer.PartNum is >= 1 and <= 4)
        {
            <Tag Color="@("processing")">
                <Icon Type="sound" Theme="@IconThemeType.Outline" /> Phần nghe
            </Tag>
        }
    </div>

    @if (!string.IsNullOrEmpty(Answer.Image))
    {
        <div style="margin-bottom:8px;">
            <img src="@Answer.Image" alt="question image"
                 style="max-width:100%; max-height:300px; border-radius:6px;" />
        </div>
    }

    @if (!string.IsNullOrEmpty(Answer.QuestionContent))
    {
        <div style="margin-bottom:12px;">
            @((MarkupString)(Answer.QuestionContent ?? ""))
        </div>
    }

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
        @foreach (var opt in Options)
        {
            string label = opt.Key;
            string? text = opt.Value;
            bool isCorrect = Answer.CorrectAnswer == label;
            bool isSelected = Answer.SelectedAnswer == label;
            string tagColor = (isSelected && isCorrect) ? "success"
                            : (isSelected && !isCorrect) ? "error"
                            : (!isSelected && isCorrect) ? "processing"
                            : "default";

            <Tag Color="@tagColor" Style="padding:6px 10px; white-space:normal; height:auto; display:block;">
                <strong>(@label)</strong> @text
                @if (isCorrect && !isSelected)
                {
                    <span style="color:inherit;"> ← Đáp án đúng</span>
                }
            </Tag>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Answer.Transcript))
    {
        <div class="question-review-transcript">
            <button type="button"
                    class="question-review-transcript-toggle"
                    aria-expanded="@_transcriptOpen"
                    @onclick="ToggleTranscript">
                <Icon Type="@(_transcriptOpen ? "up" : "down")"
                      Theme="@IconThemeType.Outline" />
                <span>Transcript</span>
            </button>
            @if (_transcriptOpen)
            {
                <div style="color:#434343;">@((MarkupString)(Answer.Transcript ?? ""))</div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(Answer.Explanation))
    {
        <Alert Type="@AlertType.Info"
               Style="margin-top:10px;"
               Message="Giải thích"
               Description="@Answer.Explanation"
               ShowIcon="true" />
    }
</Card>

<style>
    .question-review-transcript {
        margin-top: 12px;
        border-top: 1px solid #f0f0f0;
        background: #fafafa;
    }

    .question-review-transcript-toggle {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 12px 16px;
        border: 0;
        background: transparent;
        color: #262626;
        text-align: left;
        cursor: pointer;
    }

    .question-review-transcript-toggle:hover {
        color: #1677ff;
    }

    .question-review-transcript > div {
        padding: 0 16px 14px 40px;
        line-height: 1.7;
    }
</style>

@code {
    [Parameter, EditorRequired] public UserAnswerViewModel Answer { get; set; } = null!;
    [Parameter] public int QuestionNumber { get; set; }
    [Parameter] public bool ExpandTranscript { get; set; }
    [Parameter] public int ExpandTranscriptVersion { get; set; }

    private bool _transcriptOpen;
    private int _appliedExpansionVersion = -1;

    protected override void OnParametersSet()
    {
        if (_appliedExpansionVersion == ExpandTranscriptVersion)
            return;

        _transcriptOpen = ExpandTranscript;
        _appliedExpansionVersion = ExpandTranscriptVersion;
    }

    private void ToggleTranscript() => _transcriptOpen = !_transcriptOpen;

    private IEnumerable<KeyValuePair<string, string?>> Options =>
    [
        new("A", Answer.Answer1),
        new("B", Answer.Answer2),
        new("C", Answer.Answer3),
        new("D", Answer.Answer4),
    ];
}
